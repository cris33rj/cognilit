NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Populated by `supabase status` after `supabase start`.

# BYOK master key (A7). In production this MUST be injected into the
# Postgres `private.app_secrets` row 'byok_master_key' via a secret
# pipeline (e.g., supabase secrets set, then psql update) — replacing
# the dev-only default seeded by migration 0009. Length ≥ 32 chars.
BYOK_MASTER_KEY=replace-me-with-a-32+-char-random-string

# Dev-only fallback Anthropic key (A4). resolveLLMKey() falls back to
# this when NODE_ENV != 'production' AND the user has no byok_keys row.
# In production this variable is IGNORED.
ANTHROPIC_BYOK_DEV=

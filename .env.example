# Local Supabase — fill in from `supabase status` after `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# BYOK (LLM and embedding provider keys) are NOT environment variables.
# Each user registers their own keys in the UI; they are encrypted at rest in
# Supabase Vault and decrypted server-side only.
# See specs/001-marco1-nucleo-fluxo/data-model.md (byok_key).

# Async job worker
# Base URL of the Edge Functions (locally, the same as NEXT_PUBLIC_SUPABASE_URL).
# Used by pg_cron (production) and by the trigger Server Action (local/e2e).
SUPABASE_FUNCTIONS_URL=http://127.0.0.1:54321
# Shared secret that authenticates worker invocations (x-cron-secret header).
# Use a long random value outside local development.
CRON_SECRET=change-me
